---
import { GOOGLE_CALENDAR_AVAILABLE } from "../config";
---

<section id="connections">
  <div class="wrap">
    <div class="sec-head">
      <div class="mono-label reveal">connections</div>
      <h2 class="reveal">Connect your calendar.</h2>
      <p class="reveal">Tardy meets your calendar where it already lives.</p>
    </div>

    <div class="conn-grid">
      <!-- macOS Calendar -->
      <article class="conn reveal">
        <div class="top">
          <div class="logo" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
              <rect x="3" y="4.5" width="18" height="16" rx="3" />
              <path d="M3 9h18M8 2.5v4M16 2.5v4" />
            </svg>
          </div>
          <span class="badge now"><span class="dot"></span>Available now</span>
        </div>
        <h3>macOS Calendar</h3>
        <p>
          Works with any calendar in Calendar.app — iCloud, Outlook, Exchange, and
          Google accounts you've already added to your Mac.
        </p>
      </article>

      <!-- Google Calendar -->
      <article class="conn reveal">
        <div class="top">
          <div class="logo" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
              <rect x="3.5" y="4.5" width="17" height="16" rx="3" />
              <path d="M3.5 9h17M8 2.5v4M16 2.5v4" />
              <path d="M10 13.4h4M12 13.4v4" />
            </svg>
          </div>
          {GOOGLE_CALENDAR_AVAILABLE
            ? <span class="badge now"><span class="dot"></span>Available now</span>
            : <span class="badge soon"><span class="dot"></span>Coming soon</span>}
        </div>
        <h3>Google Calendar</h3>
        <p>
          {GOOGLE_CALENDAR_AVAILABLE
            ? "Connect your Google account directly inside Tardy — no system setup, with richer join links."
            : "Connect your Google account directly inside Tardy — no system setup, richer join links. In review with Google now."}
        </p>
      </article>
    </div>

    <div class="trust reveal">
      <div class="lock" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4.5" y="10.5" width="15" height="10" rx="2.5" />
          <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
        </svg>
      </div>
      <p>
        Tardy reads your events only to remind you.
        <strong>Your calendar data never leaves your device</strong> — no servers, no
        analytics, no tracking. <a href="/privacy">Read the privacy policy →</a>
      </p>
    </div>
  </div>
</section>

<style>
  .conn-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; max-width: 780px; margin: 0 auto; }
  @media (max-width: 680px) { .conn-grid { grid-template-columns: 1fr; } }
  .conn {
    position: relative; padding: 30px; border-radius: 18px;
    background: rgba(255, 255, 255, 0.025); border: 1px solid var(--line); overflow: hidden;
    transition: transform 0.25s, border-color 0.25s;
  }
  .conn:hover { transform: translateY(-4px); border-color: rgba(143, 184, 246, 0.35); }
  .top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .logo {
    width: 48px; height: 48px; border-radius: 13px; display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--line); background: rgba(255, 255, 255, 0.04); color: var(--peri);
  }
  .badge {
    font-family: "DM Mono", monospace; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 6px 11px; border-radius: 999px; display: inline-flex; align-items: center; gap: 7px;
  }
  .badge.now { color: var(--green); background: rgba(126, 224, 166, 0.1); border: 1px solid rgba(126, 224, 166, 0.3); }
  .badge.soon { color: var(--peri); background: rgba(143, 184, 246, 0.1); border: 1px solid rgba(143, 184, 246, 0.3); }
  .badge .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .badge.soon .dot { animation: blink 1.6s infinite; }
  @keyframes blink { 0%,100% { opacity: 0.35; } 50% { opacity: 1; } }
  .conn h3 { font-size: 20px; font-weight: 600; margin-bottom: 8px; }
  .conn p { color: var(--mut); font-size: 14.5px; line-height: 1.6; }

  .trust {
    margin: 36px auto 0; max-width: 780px; text-align: center; padding: 26px;
    border-radius: 16px; border: 1px dashed rgba(143, 184, 246, 0.28); background: rgba(143, 184, 246, 0.04);
  }
  .trust .lock { color: var(--peri); display: flex; justify-content: center; }
  .trust p { color: var(--mut); font-size: 15px; max-width: 560px; margin: 12px auto 0; line-height: 1.6; }
  .trust strong { color: var(--ink); }
  .trust a { color: var(--peri); text-decoration: none; border-bottom: 1px solid rgba(143, 184, 246, 0.4); }
  .trust a:hover { border-bottom-color: var(--peri); }
</style>
