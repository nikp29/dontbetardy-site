---
import { SITE } from "../config";
---

<header id="top">
  <div class="spotlight" id="spotlight"></div>
  <div class="wrap hero">
    <div class="eyebrow reveal">
      <span class="pulse"></span><span>macOS menu bar app</span>
    </div>
    <div class="count-ctx reveal">your 2:00 standup starts in</div>
    <div class="count reveal" id="count" aria-hidden="true">00:45</div>
    <h1 class="reveal">Don't be <span class="accent">tardy.</span></h1>
    <p class="sub reveal">
      A full-screen takeover before every meeting — so you never miss the start.
      Tardy reads your calendar, surfaces the join link, and counts you down.
    </p>
    <div class="cta reveal">
      <a href="/#download" class="btn btn-primary">↓ Download for Mac</a>
      <button class="btn btn-ghost" data-copy={SITE.brewCask} aria-label="Copy Homebrew install command">
        $ {SITE.brewCask}
      </button>
    </div>
  </div>
  <div class="scroll-hint" aria-hidden="true">scroll<span>↓</span></div>
</header>

<style>
  header { min-height: 100vh; display: flex; align-items: center; padding: 120px 0 80px; position: relative; }
  .hero { text-align: center; max-width: 760px; margin: 0 auto; }
  .spotlight {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background: radial-gradient(280px 280px at var(--mx, 50%) var(--my, 30%), rgba(143,184,246,0.13), transparent 70%);
    transition: background 0.15s;
  }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 9px; padding: 7px 14px;
    border: 1px solid var(--line); border-radius: 999px; background: rgba(255,255,255,0.03); margin-bottom: 30px;
  }
  .eyebrow .pulse {
    width: 7px; height: 7px; border-radius: 50%; background: var(--peri);
    box-shadow: 0 0 0 0 rgba(143,184,246,0.7); animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(143,184,246,0.6); }
    70% { box-shadow: 0 0 0 9px rgba(143,184,246,0); }
    100% { box-shadow: 0 0 0 0 rgba(143,184,246,0); }
  }
  .eyebrow span:last-child {
    font-family: "DM Mono", monospace; font-size: 12px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--mut);
  }
  .count-ctx {
    font-family: "DM Mono", monospace; font-size: 13px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--mut-2); margin-bottom: 6px;
  }
  .count {
    font-family: "DM Mono", monospace; font-weight: 500;
    font-size: clamp(72px, 15vw, 150px); line-height: 0.92; color: var(--peri);
    letter-spacing: -0.02em; text-shadow: 0 0 60px rgba(143,184,246,0.45);
    transition: transform 0.12s ease;
  }
  .count.tick { transform: scale(1.035); }
  h1 { font-weight: 700; font-size: clamp(34px, 6vw, 60px); letter-spacing: -0.035em; line-height: 1.02; margin: 14px 0 0; }
  h1 .accent { color: var(--peri); }
  .sub { color: var(--mut); font-size: clamp(16px, 2.2vw, 19px); line-height: 1.55; max-width: 480px; margin: 20px auto 32px; }
  .cta { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .scroll-hint {
    position: absolute; bottom: 28px; left: 50%; transform: translateX(-50%);
    font-family: "DM Mono", monospace; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--mut-2); display: flex; flex-direction: column; align-items: center; gap: 8px;
    animation: bob 2.4s ease-in-out infinite;
  }
  @keyframes bob { 0%,100% { transform: translate(-50%, 0); } 50% { transform: translate(-50%, 7px); } }
</style>

<script>
  // Live countdown — decorative only (reads nothing, calls nothing)
  const countEl = document.getElementById("count");
  if (countEl) {
    let t = 45;
    setInterval(() => {
      t--;
      if (t < 0) t = 45;
      const m = String(Math.floor(t / 60)).padStart(2, "0");
      const s = String(t % 60).padStart(2, "0");
      countEl.textContent = `${m}:${s}`;
      countEl.classList.add("tick");
      setTimeout(() => countEl.classList.remove("tick"), 120);
    }, 1000);
  }

  // Hero spotlight follows the cursor
  const spotlight = document.getElementById("spotlight");
  const header = document.getElementById("top");
  if (spotlight && header) {
    header.addEventListener("pointermove", (e) => {
      const r = header.getBoundingClientRect();
      spotlight.style.setProperty("--mx", `${e.clientX - r.left}px`);
      spotlight.style.setProperty("--my", `${e.clientY - r.top}px`);
    });
  }
</script>
